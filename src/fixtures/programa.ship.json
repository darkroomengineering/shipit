  "changelog": "CHANGELOG.md",
  "buildNumber": "githubRun",
  "mac": {
    "scheme": "programa",
    "bundleId": "com.darkroom.programa",
    "app": "Programa.app",
    "architectures": ["arm64"],
    "feedUrl": "https://github.com/darkroomengineering/programa/releases/latest/download/appcast.xml",
