{
  "name": "Pokefolio",
  "nightly": false,
  "version": { "file": "apps/mobile/app.json", "json": "expo.version" },
  "checks": [
    "bun run lint",
    "bun run typecheck",
    "bun run test",
    "deno test --no-lock supabase/functions/price-lookup/match_test.ts"
  ],
  "notesPaths": ["apps/mobile", "packages"],
  "credentials": "~/.config/pokefolio/asc.env",
  "ios": {
    "kind": "expo",
    "dir": "apps/mobile/ios",
    "scheme": "Pokefolio",
    "bundleId": "com.arzafran.pokefolio",
    "externalGroups": ["Public Beta"],
    "preArchive": "scripts/ship-pre-archive.sh",
    "copy": ["apps/mobile/.env.local"],
    "update": {
      "channel": "production",
      "environment": "production",
      "easCli": "eas-cli@23.1.0",
      "nativeInputs": [
        "apps/mobile/modules/*/ios/**",
        "apps/mobile/modules/*/*.podspec",
        "apps/mobile/modules/*/expo-module.config.json",
        "apps/mobile/app.json",
        "apps/mobile/package.json",
        "package.json",
        "bun.lock",
        "patches/**",
        "apps/mobile/targets/**",
        "apps/mobile/plugins/**"
      ],
      "envCheck": {
        "key": "EXPO_PUBLIC_SUPABASE_URL",
        "value": "https://jqlyedeiwtmxuovovunu.supabase.co"
      }
    }
  }
}
